      this.porcelain = this.makePorcelain();
      this.cloth = this.makeCloth();
    },
    makeWallpaper() {
      const c = document.createElement('canvas');
      c.width = 128; c.height = 128;
      const ctx = c.getContext('2d');
      ctx.fillStyle = '#100d14';
      ctx.fillRect(0, 0, 128, 128);
      ctx.strokeStyle = 'rgba(212, 175, 55, 0.05)';
      ctx.lineWidth = 1.5;
      for (let y = 0; y < 128; y += 32) {
        for (let x = 0; x < 128; x += 32) {
          ctx.beginPath();
          ctx.arc(x + 16, y + 16, 10, 0, Math.PI * 2);
          ctx.stroke();
        }
      }
      return c;
    },
    makeWood() {
      const c = document.createElement('canvas');
      c.width = 128; c.height = 128;
      const ctx = c.getContext('2d');
      ctx.fillStyle = '#24150e';
      ctx.fillRect(0, 0, 128, 128);
      ctx.strokeStyle = 'rgba(10, 5, 2, 0.35)';
      for (let i = 0; i < 40; i++) {
        ctx.beginPath();
        const y = (i / 40) * 128;
        ctx.moveTo(0, y);
        ctx.bezierCurveTo(42, y + Math.sin(i) * 4, 84, y - Math.cos(i) * 4, 128, y);
        ctx.stroke();
      }
      return c;
    },
    makePorcelain() {
      const c = document.createElement('canvas');
      c.width = 128; c.height = 128;
      const ctx = c.getContext('2d');
      ctx.fillStyle = '#dfd3c3';
      ctx.fillRect(0, 0, 128, 128);
      ctx.strokeStyle = 'rgba(45, 32, 24, 0.22)';
      ctx.lineWidth = 0.8;
      for (let i = 0; i < 12; i++) {
        ctx.beginPath();
        let x = Math.random() * 128, y = Math.random() * 128;
        ctx.moveTo(x, y);
        for (let s = 0; s < 4; s++) {
          x += (Math.random() - 0.5) * 26;
          y += (Math.random() - 0.5) * 26;
          ctx.lineTo(x, y);
        }
        ctx.stroke();
      }
      return c;
    },
    makeCloth() {
      const c = document.createElement('canvas');
      c.width = 64; c.height = 64;
      const ctx = c.getContext('2d');
      ctx.fillStyle = '#12221b';
      ctx.fillRect(0, 0, 64, 64);
      ctx.fillStyle = 'rgba(255,255,255,0.03)';
      for (let y = 0; y < 64; y += 2) {
        ctx.fillRect(0, y, 64, 1);
      }
      return c;
    }
  };

