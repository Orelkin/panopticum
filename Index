<script>
  window.addEventListener('DOMContentLoaded', () => {
    // Инициализация Telegram Mini Apps
    if (window.Telegram && window.Telegram.WebApp) {
      window.Telegram.WebApp.ready();
      window.Telegram.WebApp.expand();
    }
    // Инициализация ВКонтакте (VK Mini Apps)
    if (window.vkBridge) {
      window.vkBridge.send('VKWebAppInit').catch(() => {});
    }
    // Авто-пауза звука при сворачивании (требование Яндекс Игр и ВК)
    document.addEventListener('visibilitychange', () => {
      if (window.AudioSys && window.AudioSys.ctx) {
        document.hidden ? window.AudioSys.ctx.suspend() : (window.AudioSys.enabled && window.AudioSys.ctx.resume());
      }
    });
    // Добавление плашки студии PlayX | Niklero на стартовый экран
    const startCard = document.querySelector('.start-card');
    if (startCard) {
      const badge = document.createElement('div');
      badge.style.cssText = 'margin-bottom:12px; font-family:monospace; font-size:13px; letter-spacing:3px; color:#d4af37; text-transform:uppercase; font-weight:bold;';
      badge.innerHTML = '⚡ PLAYX STUDIO <span style="color:#8a7f70;">| BY NIKLERO</span>';
      startCard.prepend(badge);
    }
  });
</script>

