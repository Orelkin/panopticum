<script>
(() => {
  'use strict';

  // ============================================================================
  // 0. МУЛЬТИПЛАТФОРМЕННЫЙ МОСТ (TELEGRAM / VK BRIDGE / YANDEX GAMES SDK)
  // ============================================================================
  const PlatformBridge = {
    ysdk: null,
    tg: null,
    vkReady: false,

    init() {
      // 1. Telegram Mini Apps
      try {
        if (window.Telegram && window.Telegram.WebApp) {
          this.tg = window.Telegram.WebApp;
          this.tg.ready();
          this.tg.expand();
          if (this.tg.setHeaderColor) this.tg.setHeaderColor('#070609');
          if (this.tg.setBackgroundColor) this.tg.setBackgroundColor('#070609');
        }
      } catch (e) {}

      // 2. VK Bridge
      try {
        if (window.vkBridge) {
          window.vkBridge.send('VKWebAppInit').then(() => { this.vkReady = true; }).catch(() => {});
        }
      } catch (e) {}

      // 3. Яндекс Игры SDK v2
      try {
        if (window.YaGames) {
          window.YaGames.init().then(ysdk => {
            this.ysdk = ysdk;
            if (ysdk.features && ysdk.features.LoadingAPI) {
              ysdk.features.LoadingAPI.ready();
            }
          }).catch(() => {});
        }
      } catch (e) {}
    },

    gameplayStart() {
      try {
        if (this.ysdk && this.ysdk.features && this.ysdk.features.GameplayAPI) {
          this.ysdk.features.GameplayAPI.start();
        }
      } catch (e) {}
    },

    gameplayStop() {
      try {
        if (this.ysdk && this.ysdk.features && this.ysdk.features.GameplayAPI) {
          this.ysdk.features.GameplayAPI.stop();
        }
      } catch (e) {}
    },

    haptic(type = 'medium') {
      try {
        if (this.tg && this.tg.HapticFeedback) {
          this.tg.HapticFeedback.impactOccurred(type);
        } else if (navigator.vibrate) {
          navigator.vibrate(type === 'heavy' ? 45 : 18);
        }
      } catch (e) {}
    }
  };

  // Защита от скролла и зума для модерации Яндекс Игр и Telegram
  window.addEventListener('wheel', e => { if (e.ctrlKey) e.preventDefault(); }, { passive: false });
  window.addEventListener('keydown', e => {
    if (['ArrowUp','ArrowDown',' '].includes(e.key) && e.target === document.body) {
      e.preventDefault();
    }
  }, { passive: false });

  // ============================================================================
  // 1. ПРОЦЕДУРНЫЙ АУДИО-СИНТЕЗАТОР (Web Audio API)
  // ============================================================================
  class SoundEngine {
    constructor() {
      this.ctx = null;
      this.enabled = true;
      this.ambientGain = null;
    }
    init() {
      if (this.ctx) {
        if (this.ctx.state === 'suspended') this.ctx.resume();
        return;
      }
      const AC = window.AudioContext || window.webkitAudioContext;
      if (!AC) return;
      this.ctx = new AC();
      this.startAmbientDrone();
    }
    startAmbientDrone() {
      if (!this.ctx) return;
      const osc1 = this.ctx.createOscillator();
      const osc2 = this.ctx.createOscillator();
      const filter = this.ctx.createBiquadFilter();
      this.ambientGain = this.ctx.createGain();

      osc1.type = 'sawtooth';
      osc1.frequency.value = 46;
      osc2.type = 'triangle';
      osc2.frequency.value = 69;

      filter.type = 'lowpass';
      filter.frequency.value = 140;

      this.ambientGain.gain.value = this.enabled ? 0.05 : 0;

      osc1.connect(filter);
      osc2.connect(filter);
      filter.connect(this.ambientGain);
      this.ambientGain.connect(this.ctx.destination);

      osc1.start();
      osc2.start();
    }
    toggle() {
      this.enabled = !this.enabled;
      if (this.ambientGain && this.ctx) {
        this.ambientGain.gain.setTargetAtTime(this.enabled ? 0.05 : 0, this.ctx.currentTime, 0.1);
      }
      return this.enabled;
    }
    playPulse(bpm) {
      if (!this.enabled || !this.ctx) return;
      const now = this.ctx.currentTime;
      const osc = this.ctx.createOscillator();
      const g = this.ctx.createGain();
      osc.type = 'sine';
      osc.frequency.setValueAtTime(bpm > 110 ? 680 : 520, now);
      g.gain.setValueAtTime(0.06, now);
      g.gain.exponentialRampToValueAtTime(0.001, now + 0.09);
      osc.connect(g);
      g.connect(this.ctx.destination);
      osc.start(now);
      osc.stop(now + 0.095);
    }
    playClueChime() {
      if (!this.enabled || !this.ctx) return;
      const now = this.ctx.currentTime;
      [440, 554.37, 659.25].forEach((f, idx) => {
        const osc = this.ctx.createOscillator();
        const g = this.ctx.createGain();
        osc.type = 'triangle';
        osc.frequency.setValueAtTime(f, now + idx * 0.08);
        g.gain.setValueAtTime(0.11, now + idx * 0.08);
        g.gain.exponentialRampToValueAtTime(0.001, now + idx * 0.08 + 0.45);
        osc.connect(g);
        g.connect(this.ctx.destination);
        osc.start(now + idx * 0.08);
        osc.stop(now + idx * 0.08 + 0.46);
      });
    }
    playThunder() {
      if (!this.enabled || !this.ctx) return;
      const bufferSize = this.ctx.sampleRate * 1.6;
      const buffer = this.ctx.createBuffer(1, bufferSize, this.ctx.sampleRate);
      const data = buffer.getChannelData(0);
      for (let i = 0; i < bufferSize; i++) {
        data[i] = (Math.random() * 2 - 1) * Math.exp(-i / (this.ctx.sampleRate * 0.55));
      }
      const noise = this.ctx.createBufferSource();
      noise.buffer = buffer;
      const filter = this.ctx.createBiquadFilter();
      filter.type = 'lowpass';
      filter.frequency.value = 210;
      const g = this.ctx.createGain();
      g.gain.value = 0.28;
      noise.connect(filter);
      filter.connect(g);
      g.connect(this.ctx.destination);
      noise.start();
    }
    playGunshot() {
      if (!this.enabled || !this.ctx) return;
      const now = this.ctx.currentTime;
      const bufferSize = this.ctx.sampleRate * 0.28;
      const buffer = this.ctx.createBuffer(1, bufferSize, this.ctx.sampleRate);
      const data = buffer.getChannelData(0);
      for (let i = 0; i < bufferSize; i++) {
        data[i] = (Math.random() * 2 - 1) * Math.exp(-i / (this.ctx.sampleRate * 0.045));
      }
      const noise = this.ctx.createBufferSource();
      noise.buffer = buffer;
      const filter = this.ctx.createBiquadFilter();
      filter.type = 'bandpass';
      filter.frequency.setValueAtTime(900, now);
      const g = this.ctx.createGain();
      g.gain.setValueAtTime(0.45, now);
      g.gain.exponentialRampToValueAtTime(0.01, now + 0.26);
      noise.connect(filter);
      filter.connect(g);
      g.connect(this.ctx.destination);
      noise.start(now);
    }
    playNeedleOut() {
      if (!this.enabled || !this.ctx) return;
      const now = this.ctx.currentTime;
      const osc = this.ctx.createOscillator();
      const g = this.ctx.createGain();
      osc.type = 'sine';
      osc.frequency.setValueAtTime(980, now);
      osc.frequency.exponentialRampToValueAtTime(1760, now + 0.18);
      g.gain.setValueAtTime(0.14, now);
      g.gain.exponentialRampToValueAtTime(0.001, now + 0.2);
      osc.connect(g);
      g.connect(this.ctx.destination);
      osc.start(now);
      osc.stop(now + 0.21);
    }
  }

